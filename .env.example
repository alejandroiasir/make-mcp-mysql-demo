# Copia este archivo a .env y completa tus valores. El .env nunca se sube a GitHub.

# --- Modelo de IA ---
# LLM_PROVIDER: ollama (por defecto, local y sin clave) | openai | anthropic
LLM_PROVIDER=ollama
# LLM_MODEL: vacío = qwen3:8b (ollama), gpt-5-mini (openai), claude-opus-5-5 (anthropic)
LLM_MODEL=
# LLM_API_KEY: clave de OpenAI o de Anthropic (no se usa con ollama)
LLM_API_KEY=
# LLM_BASE_URL: solo para servicios compatibles con OpenAI (OpenRouter, Gemini...)
LLM_BASE_URL=

# --- Make ---
# URL del Custom webhook de tu escenario (trátala como una contraseña)
MAKE_WEBHOOK_URL=

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cne_lector
MYSQL_PASS=cambia_esta_clave
MYSQL_DB=cne_demo
